#!/usr/bin/env bash
#
# Atalho único da PoV: `overview` sobe tudo e abre o navegador.
#
#   overview            # cluster + backend + frontend + abre a aba
#   overview --ao-vivo  # idem, mais ASP e Kafka — só para GRAVAR uma execução
#   overview down       # desliga tudo (sem custo de compute no Atlas)
#   overview status     # o que está de pé
#   overview logs       # acompanha o log do backend
#
# Por padrão ASP e Kafka NÃO sobem: a aba de Streaming reproduz uma execução
# já gravada, cujos números foram medidos contra eles de verdade. Um processor
# ASP ligado cobra por segundo, e reprovisioná-lo a cada demo não muda nada do
# que aparece na tela. `--ao-vivo` é o caminho de gravar uma execução nova,
# junto com `python scripts/capture_replay.py`.
#
# Instalação (uma vez):
#   ln -sf "$(pwd)/bin/overview" /opt/homebrew/bin/overview
#
set -uo pipefail

BASE="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
[[ -d "$BASE/backend" ]] || BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

BACKEND_LOG="${TMPDIR:-/tmp}/overview-backend.log"
FRONTEND_LOG="${TMPDIR:-/tmp}/overview-frontend.log"
URL="http://localhost:5174/#streaming"

azul()  { printf "\033[36m%s\033[0m\n" "$1"; }
verde() { printf "\033[32m%s\033[0m\n" "$1"; }
ruim()  { printf "\033[31m%s\033[0m\n" "$1" >&2; }

# SOMENTE quem está escutando. `lsof -ti:8002` (sem filtro) devolve também os
# PIDs de conexões ESTABLISHED — o proxy do Vite e o próprio navegador contam.
# Com isso o `up` concluía "já estava de pé" e anunciava "✅ Pronto" sem backend
# nenhum, e o `down` mandava kill em processos que eram apenas clientes.
porta_ativa() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }
pids_ouvindo() { lsof -nP -tiTCP:"$1" -sTCP:LISTEN 2>/dev/null || true; }

espera_url() {
  local url="$1" tentativas="${2:-40}"
  for ((i = 1; i <= tentativas; i++)); do
    curl --fail --silent --max-time 2 "$url" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

subir() {
  azul "🍃 MongoDB Atlas Feature Showcase"
  echo  "   $BASE"
  echo

  if [[ "$AO_VIVO" == "1" ]]; then
    azul "▶ 1/3 Ambiente Atlas (cluster + stream processor + Kafka)"
  else
    azul "▶ 1/3 Ambiente Atlas (cluster)"
  fi
  if ! STREAMING_AO_VIVO="$AO_VIVO" "$BASE/scripts/ambiente.sh" up; then
    ruim "   ambiente não ficou consistente; a PoV não será aberta"
    exit 1
  fi
  echo

  azul "▶ 2/3 Backend :8002"
  if porta_ativa 8002; then
    echo "   já estava de pé"
  else
    ( cd "$BASE/backend" && \
      STREAMING_CS_PARTICOES="${STREAMING_CS_PARTICOES:-1}" \
      STREAMING_AO_VIVO="$AO_VIVO" \
      nohup venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002 > "$BACKEND_LOG" 2>&1 & )
    if espera_url "http://127.0.0.1:8002/health/live" 40; then
      echo "   pronto"
    else
      ruim "   backend não subiu. Log: $BACKEND_LOG"; tail -n 15 "$BACKEND_LOG" >&2; exit 1
    fi
  fi

  azul "▶ 3/3 Frontend :5174"
  if porta_ativa 5174; then
    echo "   já estava de pé"
  else
    ( cd "$BASE/frontend" && nohup npm run dev -- --host 127.0.0.1 > "$FRONTEND_LOG" 2>&1 & )
    espera_url "http://127.0.0.1:5174" 40 || { ruim "   frontend não subiu. Log: $FRONTEND_LOG"; exit 1; }
    echo "   pronto"
  fi

  echo
  if [[ "$AO_VIVO" == "1" ]]; then
    curl -s "http://127.0.0.1:8002/streaming/asp/status" 2>/dev/null | \
      python3 -c "import sys,json;d=json.load(sys.stdin);print(f\"   ASP    : {d['estado']} · tier {d.get('tier') or '—'} · {d['detalhe']}\")" 2>/dev/null || true
    curl -s "http://127.0.0.1:8002/streaming/kafka/status" 2>/dev/null | \
      python3 -c "import sys,json;d=json.load(sys.stdin);print(f\"   Kafka  : connector {d['connector']['estado']}\")" 2>/dev/null || true
  else
    # Sem ASP e sem Kafka: o que importa aqui é se existe execução gravada para
    # a aba 07 reproduzir. Sem ela, a aba não tem o que mostrar.
    curl -s "http://127.0.0.1:8002/replay/manifest" 2>/dev/null | \
      python3 -c "import sys,json
d = json.load(sys.stdin)
if d.get('disponivel'):
    print(f\"   Streaming: reproduz {d['run_id']} ({d['duracao_s']:.0f}s, gravada em {d['gravado_em']})\")
else:
    print('   Streaming: SEM execução gravada — rode STREAMING_AO_VIVO=1 overview e capture_replay.py')" 2>/dev/null || true
  fi

  echo
  verde "✅ Pronto: $URL"
  echo "   parar tudo: overview down"
  command -v open >/dev/null && open "$URL"
}

derrubar() {
  azul "▶ Finalizando a execução PIX..."
  local limpeza_ok=1 token resposta
  token="$(grep -E '^DEMO_ADMIN_TOKEN=' "$BASE/backend/.env" 2>/dev/null | head -n1 | cut -d= -f2- | sed -e 's/^["'\'']//' -e 's/["'\'']$//' -e 's/\r$//' || true)"
  if porta_ativa 8002; then
    local curl_args=(-fsS --max-time 220 -X POST "http://127.0.0.1:8002/streaming/reset?finalizar=true")
    [[ -z "$token" ]] || curl_args+=(-H "X-Demo-Token: $token")
    if resposta="$(curl "${curl_args[@]}" 2>/dev/null)" &&
       RESPOSTA="$resposta" python3 -c 'import json,os,sys
d=json.loads(os.environ["RESPOSTA"])
sys.exit(0 if d.get("finalizado") and d.get("restantes") == 0 else 1)'; then
      echo "   gerador parado, ASP parado e dados da execução removidos"
    else
      limpeza_ok=0
      ruim "   limpeza pela API falhou; o ambiente fará uma segunda limpeza direta"
    fi
  fi

  azul "▶ Parando frontend e backend..."
  local pids
  pids="$(pids_ouvindo 5174)"
  [[ -z "$pids" ]] || kill $pids 2>/dev/null || true
  pids="$(pids_ouvindo 8002)"
  [[ -z "$pids" ]] || kill $pids 2>/dev/null || true
  if "$BASE/scripts/ambiente.sh" down; then
    # A limpeza direta do ambiente é a verificação final e também cobre API
    # indisponível ou encerrada no meio da chamada.
    limpeza_ok=1
  else
    limpeza_ok=0
  fi
  if [[ "$limpeza_ok" == "1" ]]; then
    verde "✅ Tudo desligado e dados da PoV removidos."
  else
    ruim "⚠️ Ambiente desligado, mas confirme a limpeza antes da próxima execução."
    return 1
  fi
}

AO_VIVO="${STREAMING_AO_VIVO:-0}"
args=()
for arg in "$@"; do
  case "$arg" in
    --ao-vivo|--live) AO_VIVO=1 ;;
    *) args+=("$arg") ;;
  esac
done
set -- "${args[@]:-}"

case "${1:-up}" in
  up|"")   subir ;;
  down)    derrubar ;;
  status)
    porta_ativa 8002 && echo "backend : UP (:8002)" || echo "backend : DOWN"
    porta_ativa 5174 && echo "frontend: UP (:5174)" || echo "frontend: DOWN"
    "$BASE/scripts/ambiente.sh" status
    ;;
  logs)    tail -f "$BACKEND_LOG" ;;
  *)       echo "Uso: overview [--ao-vivo] [up|down|status|logs]" >&2; exit 1 ;;
esac
