MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=POC
ATLAS_PUBLIC_KEY=your_atlas_public_key
ATLAS_PRIVATE_KEY=your_atlas_private_key
ATLAS_PROJECT_ID=your_atlas_project_id
ATLAS_CLUSTER=your_cluster_name
# Tier em que cada demo COMEÇA. scripts/ambiente.sh normaliza o cluster para
# este valor no `up`, para a PoV não herdar o tier de uma execução que escalou.
# O teto do auto-scaling não é tocado: o scale-up continua disponível.
ATLAS_TIER_INICIAL=M20
# Piso do auto-scaling. Vazio = não mexe. O Atlas exige min < max estrito, e
# cada tier tem disco máximo (M10 vai até 128 GB), então nem todo piso é válido
# para um dado cluster.
ATLAS_MIN_TIER=

# Módulo Streaming
# Banco do módulo (transações, janelas, DLQ/auditoria e checkpoints).
STREAMING_DB=pix
# Coluna 2 — Kafka Connector (docker-compose.streaming.yml).
KAFKA_BROKERS=localhost:19092
CONNECT_URL=http://localhost:8083
CONNECT_CONNECTOR_NAME=atlas-pix-source
KAFKA_CONSUMER_GROUP=showcase-pix-observer
STREAMING_CS_PARTICOES=1
# TTL e TPS são calibrados para a PoV rodar inteira em M20 sem disparar o
# auto-scaling do Atlas. Subir qualquer um dos dois aumenta o conjunto vivo e a
# pressão de CPU/memória — é uma decisão de custo, não um ajuste cosmético.
STREAMING_TTL_SEGUNDOS=600
STREAMING_CONCEPT_TPS=200
# Coluna 3 — Atlas Stream Processing. Com ASP_ENABLED=false a coluna renderiza
# "não configurado" com as instruções de setup; nenhum dado é inventado.
ASP_ENABLED=false
ASP_CONNECTION_STRING=
ASP_CONNECTION_NAME=atlasCluster
ASP_PROCESSOR_NAME=pixJanelas5s
# Módulo Geo
# Database próprio, populado por scripts/seed_geo.py. Sem o search index o
# painel de busca renderiza "não configurado"; os outros dois continuam.
GEO_DB=geo
GEO_SEARCH_INDEX=idx_geo_estabelecimento
# Segurança e operação da PoV
# Sem token, mutações só são aceitas de localhost e das origens abaixo.
# Em rede compartilhada, configure um valor longo e igual ao VITE_DEMO_API_TOKEN.
DEMO_ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
MONGO_TIMEOUT_MS=8000
MAX_REQUEST_BYTES=1048576
