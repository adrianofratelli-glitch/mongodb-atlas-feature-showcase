MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=POC
ATLAS_PUBLIC_KEY=your_atlas_public_key
ATLAS_PRIVATE_KEY=your_atlas_private_key
ATLAS_PROJECT_ID=your_atlas_project_id
ATLAS_CLUSTER=your_cluster_name
# Tier esperado pelo preflight/posicionamento. O launcher não altera o tier nem
# o estado do cluster; essa decisão pertence ao operador.
ATLAS_TIER_INICIAL=M20
# Documentação operacional; não é aplicado pelo launcher.
ATLAS_MIN_TIER=

# Módulo Streaming
# Banco do módulo (transações, janelas, DLQ/auditoria e checkpoints).
STREAMING_DB=pix
# Coluna 2 — Kafka Connector (docker-compose.streaming.yml).
KAFKA_BROKERS=localhost:19092
CONNECT_URL=http://localhost:8083
CONNECT_CONNECTOR_NAME=atlas-pix-source
KAFKA_CONSUMER_GROUP=showcase-pix-observer
STREAMING_CS_PARTICOES=4
# Play executa uma rodada finita. 8k é o ponto confortável medido ponta a ponta;
# 10k permanece disponível como stress/headroom e 1k é o marco equivalente ao Inter.
STREAMING_DEMO_TPS=8000
STREAMING_DEMO_DURATION_S=30
# Rede de segurança, não limpeza principal. Reset remove imediatamente a rodada.
# Um TTL de 60 s concorreria com a ingestão e poderia quebrar a reconciliação.
STREAMING_TTL_SEGUNDOS=300
# Acima deste volume, Reset usa drop controlado em vez de delete_many.
STREAMING_DROP_ACIMA_DE=25000
STREAMING_CONCEPT_TPS=200
# Coluna 3 — Atlas Stream Processing. Com ASP_ENABLED=false a coluna renderiza
# "não configurado" com as instruções de setup; nenhum dado é inventado.
#
# O workspace do ASP precisa estar NA MESMA REGIÃO do cluster. A região de um
# workspace não pode ser alterada depois de criado (a API responde 400): trocar
# de região exige recriar o workspace, e o host abaixo muda junto. Com cluster e
# workspace em regiões diferentes, a coluna 3 mede uma ida e volta entre
# continentes e parece lentidão do produto quando é topologia.
ASP_ENABLED=false
ASP_CONNECTION_STRING=
ASP_CONNECTION_NAME=atlasCluster
ASP_PROCESSOR_NAME=pixJanelas5s
# Segundo processor: risco geográfico em event time, sink em geo.sinais_ao_vivo.
# Um pipeline implantado tem um único sink terminal, por isso são dois.
ASP_GEO_PROCESSOR_NAME=geoSinais30s
ASP_TIER=SP10
# Canal de cartão presencial dentro do stream do módulo 07: é ele que carrega
# coordenada de terminal e alimenta o sinal ao vivo do módulo 08. Em 0 o stream
# volta a ser só PIX e o painel "em event time" fica vazio.
STREAMING_CARTAO_PCT=18
# Limiares do sinal. Abaixo de MIN_KM/MIN_MIN, "velocidade" é ruído de captura
# simultânea, não deslocamento — sem esses dois pisos a tela enche de alerta
# falso de duas compras na mesma cidade.
STREAMING_SINAL_KMH=900
STREAMING_SINAL_MIN_KM=200
STREAMING_SINAL_MIN_MIN=1
# Módulo Geo
# Database próprio, populado por scripts/seed_geo.py. Sem o search index o
# painel de busca renderiza "não configurado"; os outros dois continuam.
GEO_DB=geo
GEO_SEARCH_INDEX=idx_geo_estabelecimento
# `prepare-demo.sh` aguarda o Search; `overview` só faz preflight read-only.
GEO_SEARCH_READY_TIMEOUT_SECONDS=600
# Segurança e operação da PoV
# Sem token, mutações só são aceitas de localhost e das origens abaixo.
# Em rede compartilhada, configure um valor longo e igual ao VITE_DEMO_API_TOKEN.
DEMO_ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
MONGO_TIMEOUT_MS=8000
MAX_REQUEST_BYTES=1048576
